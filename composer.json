{
    "name": "ereborcodeforge/durin-app",
    "description": "Official neutral application root for Durin (initialize with durin init)",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "php",
        "durin",
        "skeleton",
        "mithrilphp",
        "application"
    ],
    "homepage": "https://github.com/EreborCodeForge/durin-app",
    "support": {
        "source": "https://github.com/EreborCodeForge/durin-app",
        "issues": "https://github.com/EreborCodeForge/durin-app/issues"
    },
    "authors": [
        {
            "name": "Thales Ruppenthal",
            "email": "thales.rup@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-msgpack": "*",
        "ext-sockets": "*",
        "ereborcodeforge/durins-forge": "^0.2.3",
        "ereborcodeforge/mithrilphp": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "extra": {
        "mithril": {
            "kernel": "App\\Kernel",
            "eregion": "v0.3.0",
            "eregion_repo": "EreborCodeForge/eregion"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    }
}
